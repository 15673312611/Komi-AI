# API URLs
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
VITE_WIDGET_URL=http://localhost:8000

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_MESSAGING_SENDER_ID=680125690355
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here

# Google Fonts API — OPTIONAL. Only powers the font picker in agent
# customization; leave blank and a built-in font list is offered instead.
# Must be your own key: Google API keys are HTTP-referrer restricted, so a key
# issued for another domain returns 403 on yours. Get one at
# https://console.cloud.google.com/apis/credentials (enable "Web Fonts Developer
# API"), then restrict it to your app domain.
# Leave BLANK rather than a placeholder — a non-empty value is treated as a real
# key and the request goes out and fails.
VITE_GOOGLE_FONTS_API_KEY=

# Shopify API Key (for embedded apps) — optional, blank unless you ship one.
VITE_SHOPIFY_API_KEY=



# Node Environment
NODE_ENV=development
HOST=0.0.0.0
